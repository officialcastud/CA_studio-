{
  "_meta": {
    "form": "ITR-1",
    "ay": "2026-27",
    "source": "CBDT ITR-1 utility vbaProject.bin (Form_ITR1 build routines) + DataBase-sheet data-validations. Every code/label pair below is the department's own text-to-code mapping as decompiled from the VBA; nothing invented.",
    "note": "Where the utility stores a long dropdown label and the JSON exports a short code, the VBA Select-Case / If-ElseIf mapping is the authority. Codes below are the JSON leaf values."
  },

  "OptOutNewTaxRegime": {
    "leaf": "FilingStatus.OptOutNewTaxRegime",
    "source": "VBA FilingStatus() lines 33304-33322; internal BacValue drives it: BacValue=2 -> 'Y' (opting OUT of new regime = OLD regime), BacValue=1 -> 'N' (new regime, default).",
    "values": [
      {"code": "N", "label": "New tax regime u/s 115BAC(1A) (default)", "bacValue": 1},
      {"code": "Y", "label": "Opted OUT of new regime (Old regime)", "bacValue": 2}
    ]
  },

  "ReturnFileSec": {
    "leaf": "FilingStatus.ReturnFileSec",
    "type": "int",
    "source": "VBA lines 967-988 (text->code map) and FilingStatus() line 33297 (CDbl). The utility's master dropdown maps all sections, but ITR-1 is legally VALID only for the 5 codes flagged valid:true. 142(1)/148/153A/153C/139(9) are NOT valid ITR-1 filing sections and must be blocked in the rebuild.",
    "values": [
      {"code": 11, "label": "139(1) - On or before due date", "valid": true},
      {"code": 12, "label": "139(4) - Belated", "valid": true},
      {"code": 13, "label": "142(1)", "valid": false},
      {"code": 14, "label": "148", "valid": false},
      {"code": 15, "label": "153A", "valid": false},
      {"code": 16, "label": "153C", "valid": false},
      {"code": 17, "label": "139(5) - Revised", "valid": true},
      {"code": 18, "label": "139(9) - Defective", "valid": false},
      {"code": 20, "label": "119(2)(b) - After condonation of delay", "valid": true},
      {"code": 21, "label": "139(8A) - Updated return", "valid": true}
    ],
    "conditional_extra_fields": {
      "source": "FilingStatus() lines 33342-33362",
      "13|14|15|16|20": ["NoticeNo", "NoticeDateUnderSec"],
      "17": ["ReceiptNo", "OrigRetFiledDate"],
      "18": ["ReceiptNo", "NoticeNo", "OrigRetFiledDate", "NoticeDateUnderSec"],
      "21": ["ReceiptNo", "OrigRetFiledDate", "and the whole PartA_139_8A + PartB-ATI blocks"]
    }
  },

